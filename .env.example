# Run mode: backtest-public = baked replay tapes only.
DESK_MODE=backtest-public
# Public base URL for the desk (cookies / redirects). Docker: http://localhost:8000
APP_BASE_URL=http://localhost:8000
# Public Cloudflare R2 URL for manifest.json and days/*.json.gz (read-only).
R2_PUBLIC_BASE=https://pub-2b55d3698db74832b9be7d007e3ef2be.r2.dev
# Where downloaded day tapes are unpacked (Docker compose overrides to /app/replay).
REPLAY_CACHE=./replay
# How many newest days to pull on hydrate / make run-local / container start.
REPLAY_BOOTSTRAP_DAYS=10
# Set to 0 to skip R2 download in the Docker entrypoint / app start.
REPLAY_HYDRATE=1
# SQLite / app data directory (Docker compose overrides to /data).
DATA_DIR=./data
# HTTP port for the desk.
LISTEN_PORT=8000
# Cookie/session signing secret; change for any shared or long-lived deploy.
SESSION_SECRET=public-backtest-dev-only-change-me
# Optional Fernet key for encrypted settings; leave empty on the public desk
# (a throwaway key is generated at startup).
SECRETS_KEY=

